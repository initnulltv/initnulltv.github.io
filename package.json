{
  "name": "initnulltv",
  "version": "1.0.0",
  "description": "InitNullTV Website",
  "scripts": {
    "start": "bundle exec jekyll serve --livereload",
    "serve": "bundle exec jekyll serve --livereload",
    "build:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --minify",
    "build": "npm run build:css && bundle exec jekyll build",
    "watch:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --watch",
    "dev": "concurrently \"bundle exec jekyll serve --livereload\" \"tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --watch\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.31",
    "serve": "^14.2.1",
    "tailwindcss": "^3.3.5"
  }
}
