# ============================
# 🧱 JEKYLL
# ============================
_site/                # Carpeta del sitio compilado (no subir a develop)
.sass-cache/          # Caché de SASS
.jekyll-cache/        # Caché de Jekyll
.jekyll-metadata      # Metadata local
Gemfile.lock~         # Archivos temporales de Bundler
.bundle/              # Configuración local de Bundler
vendor/               # Gems locales

# ============================
# ⚙️ NODE / TAILWIND / POSTCSS
# ============================
node_modules/          # Dependencias de Node
.postcss-cache/        # Caché de PostCSS
.netlify/              # Configuración local de Netlify
dist/                  # Carpeta de build alternativa (por si la generas manualmente)
output.css.map         # Mapas de CSS (innecesarios en producción)

# ============================
# 🧰 SISTEMA Y EDITORES
# ============================
.DS_Store              # macOS
Thumbs.db              # Windows
*.log                  # Logs de errores
*.tmp                  # Archivos temporales
*.swp                  # Archivos de bloqueo de Vim
*.bak                  # Archivos de respaldo
.idea/                 # JetBrains
.vscode/               # Configuración local de VS Code

# ============================
# 🚫 GITHUB ACTIONS (control interno)
# ============================
# Evitar subir artefactos o builds locales
gh-pages/
